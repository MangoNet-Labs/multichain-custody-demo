# Use sh scripts/configure.sh to create a local .env with a random DB password.
CUSTODY_DB_PASSWORD=
CUSTODY_WEB_PORT=4310
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
MANGO_REST_URL=https://fullnode.testnet2.mangonetwork.io/rest
